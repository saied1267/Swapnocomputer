{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student registration profile",
      "type": "object",
      "properties": {
        "roll": { "type": "string" },
        "name": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "course": { "type": "string" },
        "pin": { "type": "string" },
        "regDate": { "type": "string" },
        "pictureUrl": { "type": "string" }
      },
      "required": ["roll", "name", "fatherName", "motherName", "mobile", "address", "course", "pin"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Live notice board message from center director",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "likesCount": { "type": "number" },
        "likedByUser": { "type": "boolean" }
      },
      "required": ["id", "title", "content", "date", "likesCount"]
    },
    "NoticeComment": {
      "title": "NoticeComment",
      "description": "Optional student/visitor comments on an announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "authorName", "text", "date"]
    },
    "ModelTestResult": {
      "title": "ModelTestResult",
      "description": "Marks and grade calculated for a student model test",
      "type": "object",
      "properties": {
        "roll": { "type": "string" },
        "name": { "type": "string" },
        "course": { "type": "string" },
        "mcqMarks": { "type": "number" },
        "practicalMarks": { "type": "number" },
        "vivaMarks": { "type": "number" },
        "total": { "type": "number" },
        "gpaPoint": { "type": "number" },
        "gpaGrade": { "type": "string" },
        "remarks": { "type": "string" },
        "pdfUrl": { "type": "string" }
      },
      "required": ["roll", "name", "course", "mcqMarks", "practicalMarks", "vivaMarks", "total", "gpaPoint", "gpaGrade", "remarks"]
    },
    "VisitorMessage": {
      "title": "VisitorMessage",
      "description": "Lead response or inquiry message submitted on front page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "courseOfInterest": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "name", "mobile", "courseOfInterest", "message", "date"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Realtime group and direct student-to-student chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderRoll": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverRoll": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "senderRoll", "senderName", "receiverRoll", "text", "timestamp"]
    },
    "PdfSheet": {
      "title": "PdfSheet",
      "description": "Information and download link for classroom resource files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "course": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "uploader": { "type": "string" },
        "date": { "type": "string" },
        "fileSize": { "type": "string" }
      },
      "required": ["id", "title", "course", "downloadUrl", "date"]
    },
    "CoachingPhoto": {
      "title": "CoachingPhoto",
      "description": "Gallery memories and lab photos added dynamically",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "title", "url", "date", "description"]
    }
  },
  "firestore": {
    "/students/{roll}": {
      "schema": "Student",
      "description": "Student profiles lookup"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Notice board entries"
    },
    "notices/{noticeId}/comments/{commentId}": {
      "schema": "NoticeComment",
      "description": "Notice discussion comments thread"
    },
    "/results/{roll}": {
      "schema": "ModelTestResult",
      "description": "Exam results lookup profiles"
    },
    "/visitorMessages/{messageId}": {
      "schema": "VisitorMessage",
      "description": "Contact form submissions"
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Realtime flat chat message ledger"
    },
    "/pdfSheets/{sheetId}": {
      "schema": "PdfSheet",
      "description": "Stored downloadable classroom documents"
    },
    "/coachingPhotos/{photoId}": {
      "schema": "CoachingPhoto",
      "description": "Dynamically added coaching gallery photos"
    }
  }
}
