rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Students
    match /students/{roll} {
      allow read: if true;
      allow create, update: if request.resource.data.roll == roll
        && request.resource.data.name is string
        && request.resource.data.pin is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.pin.size() <= 10;
      allow delete: if true;
    }

    // Results
    match /results/{roll} {
      allow read: if true;
      allow create, update: if request.resource.data.roll == roll
        && request.resource.data.name is string;
      allow delete: if true;
    }

    // Notices
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == noticeId
        && request.resource.data.title is string
        && request.resource.data.content is string;
      allow delete: if true;
    }

    // Notice Comments thread
    match /notices/{noticeId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.id == commentId
        && request.resource.data.authorName is string
        && request.resource.data.text is string;
      allow delete: if true;
    }

    // Visitor Messages leads
    match /visitorMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.id == messageId
        && request.resource.data.name is string
        && request.resource.data.mobile is string;
      allow delete: if true;
    }

    // Live Student Chat System
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.id == messageId
        && request.resource.data.senderRoll is string
        && request.resource.data.receiverRoll is string
        && request.resource.data.text is string;
      allow delete: if true;
    }

    // PDF Sheets
    match /pdfSheets/{sheetId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Coaching Photos
    match /coachingPhotos/{photoId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
